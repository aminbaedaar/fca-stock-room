# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). Leave them empty to run in demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: public key for phone/browser push notifications (see docs/SETUP.md)
VITE_VAPID_PUBLIC_KEY=
# AI assistant: "basic" (free, built into the app) or "claude" (needs an
# Anthropic API key saved in Supabase as ANTHROPIC_API_KEY; see docs/SETUP.md step 5)
VITE_AI_MODE=basic
