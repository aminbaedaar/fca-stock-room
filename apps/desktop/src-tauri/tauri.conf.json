{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FCA Stock Room",
  "version": "1.0.0",
  "identifier": "rw.firstchoiceafrica.stockroom",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FCA Stock Room",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob: https://*.googleusercontent.com https://*.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "First Choice Africa Limited",
    "category": "Business",
    "shortDescription": "Stock management for First Choice Africa Limited",
    "windows": { "nsis": { "installMode": "perMachine" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "endpoints": ["https://github.com/REPLACE_OWNER/REPLACE_REPO/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
