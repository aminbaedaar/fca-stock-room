{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FCA Stock Room",
  "version": "1.1.0",
  "identifier": "rw.firstchoiceafrica.stockroom",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "First Choice Africa Ltd",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob: https://*.googleusercontent.com https://*.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "First Choice Africa Limited",
    "category": "Business",
    "shortDescription": "Stock management for First Choice Africa Limited",
    "windows": { "nsis": { "installMode": "perMachine" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwNjY4QTVEQ0Y5MTRDQQpSV1RLRlBuY3BXZ0dDQ1orcStlNnpzZmJKQkNnWmNyNUVvQUx1SnFnYWdUWlBvdENqL3cySjdlNgo=",
      "endpoints": ["https://github.com/aminbaedaar/fca-stock-room/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
